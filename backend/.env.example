# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/voice-grocery-list
CORS_ORIGIN=http://localhost:5173
# Number of proxy hops in front of the backend (Railway: 1). Unset = 1 in
# production, none in development. Rate limits key on the client IP derived
# from this; "true" is treated as 1 because it would let clients spoof their IP.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# OCR Microservice (EasyOCR)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_API_KEY=<>
OCR_SERVICE_URL=http://localhost:8000
# Shared secret: set the same value on the OCR service. Its /ocr endpoint
# refuses requests without it (local dev: OCR_ALLOW_UNAUTHENTICATED=true there)
OCR_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Email / Notifications
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Grocery List App <noreply@example.com>"
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Authentication / Security
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_secure_random_value

# -----------------------------------------------------------------------------
# Sign-up (personal-use app: CLOSED unless configured)
# -----------------------------------------------------------------------------
# Nothing set            -> closed: account creation always refused (default)
# REGISTRATION_INVITE_CODE=... -> invite: sign-up only with this exact code
#                           (surrounding whitespace ignored; remove or rotate
#                           it once the invited person has signed up)
# SIGNUP_OPEN=true       -> open: anyone can sign up (wins over an invite code)
# Read on every request. The 10-account cap applies in every mode.
# REGISTRATION_INVITE_CODE=
# SIGNUP_OPEN=false

# -----------------------------------------------------------------------------
# RAG / AI Pipeline
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
RAG_EMBEDDINGS_MODEL=text-embedding-3-large
RAG_COMPLETIONS_MODEL=gpt-4o
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_VECTOR_INDEX=receiptVectorIndex
EMBEDDINGS_VERSION=3

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001/api
