{
  "name": "voice-grocery-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/x-charts": "^6.19.8",
    "@mui/x-date-pickers": "^6.20.2",
    "dayjs": "^1.11.18",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "validator": "^13.15.22"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "sharp": "^0.35.3",
    "terser": "^5.44.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.1.0",
    "workbox-window": "^7.3.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.14.2",
      "body-parser": "^1.20.6",
      "path-to-regexp@<1": "^0.1.13",
      "form-data": "^4.0.6",
      "prismjs": "^1.30.0",
      "mdast-util-to-hast": "^13.2.1"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm lint && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "build:prod": "NODE_ENV=production pnpm lint && vite build",
    "build:analyze": "vite build --mode analyze",
    "clean": "rm -rf dist",
    "deploy:netlify": "pnpm build && netlify deploy --prod --dir=dist",
    "serve": "vite preview --host --port 4173",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "eslint src --max-warnings 10",
    "lint:backend": "cd backend && pnpm lint",
    "lint:fix": "pnpm lint:frontend:fix && pnpm lint:backend:fix",
    "lint:frontend:fix": "eslint src --fix",
    "lint:backend:fix": "cd backend && pnpm lint:fix",
    "postinstall": "echo 'Run pnpm lint to check for issues'"
  }
}
